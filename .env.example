# Copy to .env and adjust if needed. All values are optional.
# API keys are NOT set here. They are entered on the setup screen at first
# run and stored in the local SQLite database (server/data/app.db).

# Port the Express backend listens on
PORT=3001

# Host to bind. Must be a loopback address; the server refuses anything else
# because the app is single user, local only, and fronts a brokerage account.
HOST=127.0.0.1

# Claude model used for chat. Leave unset for the default.
# ANTHROPIC_MODEL=claude-sonnet-5
